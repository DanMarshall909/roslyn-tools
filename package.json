{
  "name": "roslyn-tools-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "mutation": "node scripts/mutation.mjs",
    "test:mutation-driver": "node --test tests/mutation-driver.test.mjs",
    "dev": "astro dev --port 3000",
    "generate:commands": "node scripts/generate-site-command-reference.mjs",
    "prebuild": "npm run generate:commands",
    "build": "astro build",
    "preview": "astro preview",
    "test:content": "node --test tests/site/content-contract.test.mjs",
    "test:site": "node --test tests/site/built-site.test.mjs",
    "test": "npm run test:content && npm run build && npm run test:site"
  },
  "dependencies": {
    "astro": "7.2.8"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "engines": {
    "node": ">=22"
  }
}
