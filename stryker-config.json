{
  "stryker-config": {
    "project": "src/RoslynTools/RoslynTools.csproj",
    "test-projects": [
      "tests/RoslynTools.Tests/RoslynTools.Tests.csproj"
    ],
    "mutate": [
      "**/Commands/MakeSealedCommand.cs",
      "**/Commands/DebugCommand.cs",
      "**/Commands/Results/DebugResult.cs",
      "**/Commands/Results/FindDuplicatesResult.cs",
      "**/Commands/Results/MagicStringResult.cs",
      "**/Core/DependencyInjector.cs",
      "**/Core/NamespaceMoveRewriter.cs",
      "**/Core/InstanceReachabilityAnalyzer.cs",
      "**/Core/MethodExtractorBuilder.cs",
      "**/Services/DebugTraceAnalyzerService.cs",
      "**/Models/DebugReport.cs",
      "**/RoslynTools.Cli/App.cs"
    ],
    "reporters": [
      "html",
      "progress",
      "cleartext",
      "json"
    ],
    "thresholds": {
      "high": 100,
      "low": 95,
      "break": 0
    },
    "concurrency": 16
  }
}
