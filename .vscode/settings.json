{
  // C# Dev Kit / .NET Test Explorer integration.
  // These tests run on AdhocWorkspace (no real MSBuild) except for
  // WorkspaceLoaderSmokeTests — so no special test host setup needed.
  "dotnet.defaultSolution": "RoslynTools.slnx",

  // dotnet.unitTests extension (formulahendry.dotnet-test-explorer), if installed.
  "dotnet-test-explorer.testProjectPath": "tests/RoslynTools.Tests/RoslynTools.Tests.csproj",
  "dotnet-test-explorer.autoWatch": true,
  "dotnet-test-explorer.showCodeLens": true,

  // Keep file-watcher noise low — the TestOutput dir churns during test runs.
  "files.watcherExclude": {
    "**/bin/**": true,
    "**/obj/**": true,
    "**/TestOutput/**": true
  },
  "search.exclude": {
    "**/bin": true,
    "**/obj": true,
    "**/TestOutput": true
},
"workbench.colorCustomizations": {
    "activityBar.activeBackground": "#84a6c4",
    "activityBar.background": "#84a6c4",
    "activityBar.foreground": "#15202b",
    "activityBar.inactiveForeground": "#15202b99",
    "activityBarBadge.background": "#f5e9ef",
    "activityBarBadge.foreground": "#15202b",
    "commandCenter.border": "#15202b99",
    "sash.hoverBorder": "#84a6c4",
    "statusBar.background": "#628db4",
    "statusBar.foreground": "#15202b",
    "statusBarItem.hoverBackground": "#49739a",
    "statusBarItem.remoteBackground": "#628db4",
    "statusBarItem.remoteForeground": "#15202b",
    "titleBar.activeBackground": "#628db4",
    "titleBar.activeForeground": "#15202b",
    "titleBar.inactiveBackground": "#628db499",
    "titleBar.inactiveForeground": "#15202b99"
},
"peacock.color": "#628db4"
}
