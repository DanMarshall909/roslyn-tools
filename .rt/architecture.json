{
  "$schema": "../docs/schemas/architecture-v1.schema.json",
  "version": 1,
  "layers": [
    {
      "name": "Core",
      "projects": [
        "RoslynTools"
      ],
      "allowedProjectReferences": []
    },
    {
      "name": "Hosting",
      "projects": [
        "RoslynTools.Hosting"
      ],
      "allowedProjectReferences": [
        "Core"
      ]
    },
    {
      "name": "Adapters",
      "projects": [
        "RoslynTools.Adapters"
      ],
      "allowedProjectReferences": [
        "Core",
        "Hosting"
      ]
    },
    {
      "name": "Daemon",
      "projects": [
        "RoslynTools.DaemonHost"
      ],
      "allowedProjectReferences": [
        "Core",
        "Hosting",
        "Adapters"
      ]
    },
    {
      "name": "Cli",
      "projects": [
        "RoslynTools.Cli"
      ],
      "allowedProjectReferences": [
        "Core",
        "Hosting",
        "Adapters",
        "Daemon"
      ]
    },
    {
      "name": "Mcp",
      "projects": [
        "RoslynTools.Mcp"
      ],
      "allowedProjectReferences": [
        "Core",
        "Hosting",
        "Adapters"
      ]
    },
    {
      "name": "Tests",
      "projects": [
        "RoslynTools.Tests",
        "RoslynTools.Tests.Mcp"
      ],
      "allowedProjectReferences": [
        "Core",
        "Hosting",
        "Adapters",
        "Daemon",
        "Cli",
        "Mcp"
      ],
      "allowSameLayerReferences": true
    }
  ]
}
