{
  "$schema": "../docs/schemas/architecture-v1.schema.json",
  "version": 1,
  "layers": [
    {
      "name": "Core",
      "projects": ["RoslynTools"],
      "allowedProjectReferences": []
    },
    {
      "name": "Cli",
      "projects": ["RoslynTools.Cli"],
      "allowedProjectReferences": ["Core"]
    },
    {
      "name": "Mcp",
      "projects": ["RoslynTools.Mcp"],
