<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CA1861;CA2016;CA1822;CA1852</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RoslynTools.Tests.Mcp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../RoslynTools/RoslynTools.csproj" />
    <ProjectReference Include="../RoslynTools.Cli/RoslynTools.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

</Project>
