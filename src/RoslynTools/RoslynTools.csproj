<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>RoslynTools</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <EmbeddedResource Include="../../code-smells.json" LogicalName="RoslynTools.code-smells.json" />
        <InternalsVisibleTo Include="RoslynTools.Tests"/>
        <InternalsVisibleTo Include="RoslynTools.Mcp"/>
        <InternalsVisibleTo Include="RoslynTools.Tests.Mcp"/>
        <InternalsVisibleTo Include="rt"/>
        <InternalsVisibleTo Include="RoslynTools.Adapters"/>
        <InternalsVisibleTo Include="RoslynTools.Hosting"/>
        <InternalsVisibleTo Include="RoslynTools.DaemonHost"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Build.Locator"/>
        <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
    </ItemGroup>
</Project>
