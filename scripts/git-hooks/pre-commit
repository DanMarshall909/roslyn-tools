#!/bin/sh
set -e

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

mutation_enabled="$(node scripts/mutation-policy.mjs)"
if [ "$mutation_enabled" = false ]; then
    echo "mutation-gate: mutation testing is disabled; skipping." >&2
    exit 0
fi

if command -v pwsh >/dev/null 2>&1; then
    exec pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/pre-commit-gates.ps1
fi

exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/pre-commit-gates.ps1
