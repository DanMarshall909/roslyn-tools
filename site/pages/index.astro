---
import BaseLayout from '../layouts/BaseLayout.astro';

const description = 'Agent-first semantic C# refactoring with compiler-backed navigation, analysis, reviewable changes, and structured output.';
---

<BaseLayout title="Roslyn Tools" description={description} activePath="/">
  <section class="hero">
    <div class="site-shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Agent-first C# refactoring · CLI + MCP</p>
        <h1>Refactoring for AI Agents</h1>
        <p class="hero-lead">
          Give coding agents compiler-backed context to navigate whole
          solutions, reason about impact, and prepare reviewable changes.
        </p>
        <div class="button-row">
          <a class="button button-primary" href="/docs/getting-started/">Get started</a>
          <a class="button button-secondary" href="/docs/discovery/">Explore workflows</a>
        </div>
        <div class="package-callout" aria-label="Installation command">
          <span>Install</span>
          <code>dotnet tool install --global roslyn-tools-rt</code>
        </div>
      </div>
      <div class="code-window" aria-label="Roslyn Tools example">
        <div class="code-window-bar">
          <span>terminal</span>
          <span class="code-status">solution-aware</span>
        </div>
        <pre><code><span class="code-muted"># Start from the job, not a command name</span>
rt suggest <span class="code-string">"find every caller of a method"</span>

<span class="code-muted"># Resolve the symbol semantically</span>
rt inspect describe BookingService \
  --solution MyApp.slnx --json

<span class="code-muted"># Review the proposed solution-wide change</span>
rt refactor rename BookingService \
  ReservationService --solution MyApp.slnx \
  --dry-run</code></pre>
      </div>
    </div>
  </section>

  <section class="lineage-section">
    <div class="site-shell lineage-row">
      <p>Agent-first by design. Built on Roslyn. Whole-solution context. Review-first changes.</p>
      <a class="text-link" href="/docs/inspecting-code/">See semantic inspection <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="principles-section" id="principles">
    <div class="site-shell">
      <div class="section-heading">
        <p class="eyebrow">Built for AI coding agents</p>
        <h2>Semantic context for every change.</h2>
      </div>
      <div class="principle-grid">
        <article>
          <span class="principle-number">01</span>
          <h3>Agent-first by design</h3>
          <p>Start from a goal, discover an ordered workflow, and consume bounded structured results without scraping a terminal.</p>
        </article>
        <article>
          <span class="principle-number">02</span>
          <h3>Compiler-backed</h3>
          <p>Resolve symbols, overloads, references, implementations, and project boundaries through Roslyn.</p>
        </article>
        <article>
          <span class="principle-number">03</span>
          <h3>Review first</h3>
          <p>Preview source changes, carry explicit workspace context, and keep repository effects visible.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="boundary-section">
    <div class="site-shell boundary-grid">
      <div>
        <p class="eyebrow">One application spine</p>
        <h2>One semantic contract for every agent.</h2>
      </div>
      <div class="boundary-copy">
        <p>
          Host-neutral operations keep semantic results and safety policy
          consistent whether a human runs <code>rt</code> or an agent calls a tool.
        </p>
        <a class="text-link" href="/docs/automation-and-mcp/">Use rt with an agent <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
