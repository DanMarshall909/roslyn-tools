---
import BaseLayout from '../layouts/BaseLayout.astro';

const description = 'An MCP server that gives AI coding agents compiler-backed C# navigation, analysis, and refactoring context across complete solutions.';
---

<BaseLayout title="Roslyn Tools" description={description} activePath="/">
  <section class="hero">
    <div class="site-shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">MCP server for semantic C# · powered by Roslyn</p>
        <h1>The MCP server for semantic C#.</h1>
        <p class="hero-lead">
          Give coding agents compiler-backed tools to navigate whole solutions,
          analyze impact, and prepare refactoring work with bounded, structured results.
        </p>
        <div class="button-row">
          <a class="button button-primary" href="/docs/automation-and-mcp/">Connect with MCP</a>
          <a class="button button-secondary" href="/docs/discovery/">Explore agent workflows</a>
        </div>
        <div class="package-callout" aria-label="MCP server command">
          <span>MCP host</span>
          <code>roslyn-tools-mcp</code>
        </div>
      </div>
      <div class="code-window" aria-label="Roslyn Tools example">
        <div class="code-window-bar">
          <span>MCP tools</span>
          <span class="code-status">compiler-backed</span>
        </div>
        <pre><code><span class="code-muted"># Your MCP client starts Roslyn Tools</span>
<span class="code-string">"command"</span>: <span class="code-string">"roslyn-tools-mcp"</span>

<span class="code-muted"># The agent resolves a symbol semantically</span>
search_symbols {
  <span class="code-string">"query"</span>: <span class="code-string">"BookingService"</span>,
  <span class="code-string">"solution"</span>: <span class="code-string">"MyApp.slnx"</span>
}

<span class="code-muted"># Then follows compiler-known callers</span>
relationships {
  <span class="code-string">"symbol"</span>: <span class="code-string">"BookingService.ReserveAsync"</span>,
  <span class="code-string">"mode"</span>: <span class="code-string">"callers"</span>
}</code></pre>
      </div>
    </div>
  </section>

  <section class="lineage-section">
    <div class="site-shell lineage-row">
      <p>MCP-first by design. Built on Roslyn. Whole-solution context. Structured agent results.</p>
      <a class="text-link" href="/docs/automation-and-mcp/">Connect your agent <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="principles-section" id="principles">
    <div class="site-shell">
      <div class="section-heading">
        <p class="eyebrow">An agent-native MCP surface</p>
        <h2>Semantic context instead of text guesses.</h2>
      </div>
      <div class="principle-grid">
        <article>
          <span class="principle-number">01</span>
          <h3>MCP-first by design</h3>
          <p>Agents discover focused semantic tools and consume bounded, structured results without scraping a terminal.</p>
        </article>
        <article>
          <span class="principle-number">02</span>
          <h3>Compiler-backed</h3>
          <p>Resolve symbols, overloads, references, implementations, and project boundaries through Roslyn.</p>
        </article>
        <article>
          <span class="principle-number">03</span>
          <h3>Review first</h3>
          <p>Preview source changes, carry explicit workspace context, and keep repository effects visible.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="boundary-section">
    <div class="site-shell boundary-grid">
      <div>
        <p class="eyebrow">MCP first · CLI included</p>
        <h2>One semantic engine. MCP is the front door.</h2>
      </div>
      <div class="boundary-copy">
        <p>
          Coding agents call compiler-backed tools over MCP. Humans and automation
          can use the companion <code>rt</code> CLI for the same semantic operations.
        </p>
        <a class="text-link" href="/docs/automation-and-mcp/">Set up the MCP server <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
